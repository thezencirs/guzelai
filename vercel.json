{
  "framework": "vite",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/primetime",
      "schedule": "15 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/ajanlar(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ]
}
