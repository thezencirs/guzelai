# Platform-owned Gemini API key. Required for "GüzelAI Kredileri" mode.
GEMINI_API_KEY="YOUR_PLATFORM_GEMINI_API_KEY"

# Recommended: separate 32+ character secret used to encrypt BYOK keys stored in HttpOnly cookies.
# If omitted, GEMINI_API_KEY is used as the encryption secret.
AI_KEY_ENCRYPTION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Current production model defaults.
GEMINI_TEXT_MODEL="gemini-3.6-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
VEO_MODEL="veo-3.1-generate-preview"

# Google Identity Services OAuth Web Client ID.
# Use the same client ID in both variables so frontend and backend can verify the ID token.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"

APP_URL="https://www.guzelai.com"
